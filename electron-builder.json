{
  "appId": "com.dingdingprojects.claudedesigndesktop",
  "productName": "Claude Design Desktop",
  "executableName": "Claude Design Desktop",
  "asar": true,
  "directories": {
    "output": "dist/squirrel-windows",
    "buildResources": "build/resources"
  },
  "files": [
    "dist/main.cjs",
    "dist/preload.cjs",
    "dist/renderer.js",
    "dist/renderer.css",
    "dist/renderer.html",
    "dist/assets/**",
    "dist/site/**",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist/resources/codex",
      "to": "codex",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["squirrel"],
    "signAndEditExecutable": false,
    "signExecutable": false
  },
  "squirrelWindows": {
    "artifactName": "Setup.${ext}",
    "msi": false,
    "useAppIdAsId": true
  },
  "forceCodeSigning": false
}
